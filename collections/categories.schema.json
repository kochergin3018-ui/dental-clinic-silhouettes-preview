{
  "$ref": "#/definitions/categories",
  "definitions": {
    "categories": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "errorMessage": {
            "pattern": "slug: только латиница в нижнем регистре, цифры и дефисы"
          }
        },
        "parent": {
          "$ref": "#/definitions/categories/properties/slug"
        },
        "order": {
          "type": "integer",
          "default": 100
        },
        "lead": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "badges": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "faq": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "q": {
                "type": "string",
                "minLength": 1
              },
              "a": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "q",
              "a"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "seo": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "slug",
        "lead",
        "description"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}